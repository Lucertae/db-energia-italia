{
  "version": 1,
  "domains": {
    "gas": {
      "description": "US Henry Hub, EU gas proxy, US working storage",
      "series": ["HUB", "TTF", "NGS", "VIX"]
    },
    "oil": {
      "description": "Brent spot, US crude inventory, volatility",
      "series": ["BRT", "CRU", "VIX"]
    }
  },
  "series": {
    "HUB": {
      "desk_id": "HUB",
      "name": "Henry Hub spot",
      "source": "FRED",
      "fred_id": "DHHNGSP",
      "freq": "daily",
      "unit": "USD/MMBtu",
      "revision_risk": "low",
      "pit_required": false,
      "cache_paths": ["cache/HUB.csv", "cache/fred/HUB.csv"],
      "value_col_hint": "DHHNGSP",
      "notes": "Primary US gas benchmark; theory-of-storage anchor"
    },
    "TTF": {
      "desk_id": "TTF",
      "name": "EU natural gas proxy (FRED USD)",
      "source": "FRED",
      "fred_id": "PNGASEUUSDM",
      "freq": "monthly",
      "unit": "USD/MMBtu",
      "revision_risk": "low",
      "pit_required": false,
      "cache_paths": ["cache/TTF.csv", "cache/fred/TTF.csv"],
      "value_col_hint": "PNGASEUUSDM",
      "notes": "NOT ICE TTF futures; monthly proxy — resample before daily join"
    },
    "NGS": {
      "desk_id": "NGS",
      "name": "US gas working storage",
      "source": "EIA_PUBLIC",
      "eia_series": "NW2_EPG0_SWO_R48_BCF",
      "freq": "weekly",
      "unit": "BCF",
      "revision_risk": "medium",
      "pit_required": false,
      "cache_paths": ["cache/NGS.csv", "cache/eia/NGS.csv"],
      "value_col_hint": "VALUE",
      "notes": "EIA LeafHandler weekly gas storage — no API key"
    },
    "BRT": {
      "desk_id": "BRT",
      "name": "Brent EU spot",
      "source": "FRED",
      "fred_id": "DCOILBRENTEU",
      "freq": "daily",
      "unit": "USD/bbl",
      "revision_risk": "low",
      "pit_required": false,
      "cache_paths": ["cache/BRT.csv", "cache/fred/BRT.csv"],
      "value_col_hint": "DCOILBRENTEU"
    },
    "CRU": {
      "desk_id": "CRU",
      "name": "US crude stocks ex-SPR",
      "source": "EIA_PUBLIC",
      "eia_series": "WCESTUS1",
      "freq": "weekly",
      "unit": "kbbl",
      "revision_risk": "medium",
      "pit_required": false,
      "cache_paths": ["cache/CRU.csv", "cache/eia/CRU.csv"],
      "value_col_hint": "VALUE"
    },
    "VIX": {
      "desk_id": "VIX",
      "name": "CBOE VIX",
      "source": "FRED",
      "fred_id": "VIXCLS",
      "freq": "daily",
      "unit": "index",
      "revision_risk": "low",
      "pit_required": false,
      "cache_paths": ["cache/VIX.csv", "cache/fred/VIX.csv"],
      "value_col_hint": "VIXCLS",
      "notes": "Strong oil return predictor per MDPI 2025; lag 1-5d"
    }
  }
}
