    {
      "id": "gas",
      "label_it": "Gas",
      "label_en": "Gas",
      "layer_oim": "Oil & Natural Gas",
      "geometrie": ["LineString"],
      "imposm_tables": ["pipeline"],
      "osm_base": {
        "man_made": "pipeline",
        "substance": ["gas", "natural_gas", "cng", "lpg", "lng"]
      },
      "voci": [
        {
          "id": "gas_tx_dn700",
          "label_it": "Transmission >= DN 700",
          "filter": {
            "sql": "substance IN ('gas','natural_gas','cng','lpg','lng') AND usage = 'transmission' AND diameter::numeric >= 700"
          }
        },
        {
          "id": "gas_tx_dn300",
          "label_it": "Transmission >= DN 300",
          "filter": {
            "sql": "substance IN ('gas','natural_gas','cng','lpg','lng') AND usage = 'transmission' AND diameter::numeric >= 300 AND diameter::numeric < 700"
          }
        },
        {
          "id": "gas_tx_lt_dn300",
          "label_it": "Transmission < DN 300",
          "filter": {
            "sql": "substance IN ('gas','natural_gas','cng','lpg','lng') AND usage = 'transmission' AND (diameter IS NULL OR diameter::numeric < 300)"
          }
        },
        {
          "id": "gas_dist_high",
          "label_it": "Distribution High Pressure",
          "filter": {
            "sql": "substance IN ('gas','natural_gas','cng','lpg','lng') AND COALESCE(usage,'') <> 'transmission' AND (pressure = 'high' OR pressure::numeric >= 1)"
          }
        },
        {
          "id": "gas_dist_intermediate",
          "label_it": "Distribution Intermediate Pressure",
          "filter": {
            "sql": "substance IN ('gas','natural_gas','cng','lpg','lng') AND COALESCE(usage,'') <> 'transmission' AND NOT (pressure = 'high' OR NULLIF(pressure,'')::numeric >= 1) AND (pressure = 'intermediate' OR pressure::numeric >= 0.1)"
          }
        },
        {
          "id": "gas_dist_low",
          "label_it": "Distribution Low Pressure",
          "filter": {
            "sql": "substance IN ('gas','natural_gas','cng','lpg','lng') AND COALESCE(usage,'') <> 'transmission' AND NOT (pressure = 'high' OR NULLIF(pressure,'')::numeric >= 1) AND NOT (pressure = 'intermediate' OR NULLIF(pressure,'')::numeric >= 0.1)"
          }
        }
      ]
    },
