            "osm": { "power": "compensator" },
            "sql": "type = 'compensator' AND COALESCE(compensator,type) NOT IN ('series_reactor','shunt_reactor','series_capacitor','shunt_capacitor','filter')"
          }
        },
        {
          "id": "conversione_dc",
          "label_it": "Sottostazione di conversione DC",
