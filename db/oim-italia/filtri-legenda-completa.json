            "osm": { "power": "compensator", "compensator": "shunt_reactor" },
            "sql": "type = 'shunt_reactor' OR compensator = 'shunt_reactor'"
          }
        },
        {
          "id": "condensatore_serie",
          "label_it": "Condensatore serie",
          "filter": {
            "osm": { "power": "compensator", "compensator": "series_capacitor" },
            "sql": "type = 'series_capacitor' OR compensator = 'series_capacitor'"
          }
        },
        {
          "id": "condensatore_shunt",
          "label_it": "Condensatore shunt",
          "filter": {
            "osm": { "power": "compensator", "compensator": "shunt_capacitor" },
            "sql": "type = 'shunt_capacitor' OR compensator = 'shunt_capacitor'"
          }
        },
        {
          "id": "filtro",
