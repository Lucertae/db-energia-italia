{
  "meta": {
    "fonte": "Open Infrastructure Map (openinframap.org) + OpenStreetMap",
    "riferimento_codice": "https://github.com/openinframap/openinframap",
    "categorie": 10,
    "voci": 75,
    "uso": "Catalogo filtri massimi per import in DB vettoriale (PostGIS). Ogni voce ha tag OSM, tabelle Imposm OIM e predicato SQL di classificazione.",
    "layer_ui_oim": ["Power", "Telecoms", "Oil & Natural Gas", "Other Pipelines", "Water"]
  },
  "categorie": [
    {
      "id": "linee_elettriche",
      "label_it": "Linee elettriche",
      "label_en": "Power Lines",
      "layer_oim": "Power",
      "geometrie": ["LineString"],
      "imposm_tables": ["power_line", "power_circuit_relation"],
      "osm_base": {
        "power": ["line", "minor_line", "cable", "minor_cable"],
        "also": ["construction:power", "disused:power"]
      },
      "voci": [
        {
          "id": "lt_10kv",
          "label_it": "< 10 kV",
          "filter": {
            "sql": "frequency IS DISTINCT FROM '0' AND (frequency IS NULL OR frequency IN ('','50','60') OR frequency::numeric IN (50,60)) AND COALESCE(convert_voltage(voltage),0) < 10000",
            "note": "Scala OIM: sotto soglia 10 kV; esclude HVDC e trazione"
          }
        },
        {
          "id": "ge_10kv",
          "label_it": "≥ 10 kV",
          "filter": {
            "sql": "NOT hvdc AND NOT traction AND COALESCE(convert_voltage(voltage),0) >= 10000 AND COALESCE(convert_voltage(voltage),0) < 25000"
          }
        },
        {
          "id": "ge_25kv",
          "label_it": "≥ 25 kV",
          "filter": {
            "sql": "NOT hvdc AND NOT traction AND COALESCE(convert_voltage(voltage),0) >= 25000 AND COALESCE(convert_voltage(voltage),0) < 52000"
          }
        },
        {
          "id": "ge_52kv",
          "label_it": "≥ 52 kV",
          "filter": {
            "sql": "NOT hvdc AND NOT traction AND COALESCE(convert_voltage(voltage),0) >= 52000 AND COALESCE(convert_voltage(voltage),0) < 132000"
          }
        },
        {
          "id": "ge_132kv",
          "label_it": "≥ 132 kV",
          "filter": {
            "sql": "NOT hvdc AND NOT traction AND COALESCE(convert_voltage(voltage),0) >= 132000 AND COALESCE(convert_voltage(voltage),0) < 220000"
          }
        },
        {
          "id": "ge_220kv",
          "label_it": "≥ 220 kV",
          "filter": {
            "sql": "NOT hvdc AND NOT traction AND COALESCE(convert_voltage(voltage),0) >= 220000 AND COALESCE(convert_voltage(voltage),0) < 310000"
          }
        },
        {
          "id": "ge_310kv",
          "label_it": "≥ 310 kV",
          "filter": {
            "sql": "NOT hvdc AND NOT traction AND COALESCE(convert_voltage(voltage),0) >= 310000 AND COALESCE(convert_voltage(voltage),0) < 550000"
          }
        },
        {
          "id": "ge_550kv",
          "label_it": "≥ 550 kV",
          "filter": {
            "sql": "NOT hvdc AND NOT traction AND COALESCE(convert_voltage(voltage),0) >= 550000"
          }
        },
        {
          "id": "hvdc",
          "label_it": "HVDC",
          "filter": {
            "sql": "frequency IS NOT NULL AND frequency <> '' AND frequency::numeric = 0",
            "osm": { "frequency": "0" }
          }
        },
        {
          "id": "trazione",
          "label_it": "Trazione (< 50 Hz)",
          "filter": {
            "sql": "frequency IS NOT NULL AND frequency <> '' AND frequency::numeric NOT IN (0, 50, 60)",
            "note": "OIM: frequenza presente e diversa da 50/60 (e non HVDC)"
          }
        },
        {
          "id": "sotterranea",
          "label_it": "Sotterranea",
          "filter": {
            "sql": "location IN ('underground','underwater') OR tunnel IS TRUE OR (type IN ('cable','minor_cable') AND COALESCE(location,'') = '')",
            "osm": {
              "location": ["underground", "underwater"],
              "tunnel": "yes",
              "power": ["cable", "minor_cable"]
            },
            "note": "Flag ortogonale alla tensione: una linea può essere sia ≥220kV sia sotterranea"
          }
        },
        {
          "id": "matricola_linea",
          "label_it": "Matricola linea",
          "filter": {
            "sql": "ref IS NOT NULL AND ref <> ''",
            "osm": { "ref": "*" },
            "note": "Etichetta/simbolo su linee con ref; non è un tipo geometrico separato"
          }
        }
      ]
    },
    {
      "id": "centrali_elettriche",
      "label_it": "Centrali elettriche",
      "label_en": "Power Plants",
      "layer_oim": "Power",
      "geometrie": ["Polygon"],
      "imposm_tables": ["power_plant", "power_plant_relation"],
      "osm_base": { "power": ["plant"], "also": ["construction:power"] },
      "campo_classificazione": "plant:source",
      "voci": [
        {
          "id": "carbone",
          "label_it": "Carbone",
          "filter": { "osm": { "plant:source": "coal" }, "sql": "source = 'coal'" }
        },
        {
          "id": "geotermico",
          "label_it": "Geotermico",
          "filter": { "osm": { "plant:source": "geothermal" }, "sql": "source = 'geothermal'" }
        },
        {
          "id": "idroelettrico",
          "label_it": "Idroelettrico",
          "filter": { "osm": { "plant:source": "hydro" }, "sql": "source = 'hydro'" }
        },
        {
          "id": "nucleare",
          "label_it": "Nucleare",
          "filter": { "osm": { "plant:source": "nuclear" }, "sql": "source = 'nuclear'" }
        },
        {
          "id": "gas_petrolio",
          "label_it": "Gas/Petrolio",
          "filter": {
            "osm": { "plant:source": ["oil", "gas", "diesel"] },
            "sql": "source IN ('oil','gas','diesel')"
          }
        },
        {
          "id": "solare",
          "label_it": "Solare",
          "filter": { "osm": { "plant:source": "solar" }, "sql": "source = 'solar'" }
        },
        {
          "id": "eolico",
          "label_it": "Eolico",
          "filter": { "osm": { "plant:source": "wind" }, "sql": "source = 'wind'" }
        },
        {
          "id": "biomassa",
          "label_it": "Biomassa",
          "filter": { "osm": { "plant:source": "biomass" }, "sql": "source = 'biomass'" }
        },
        {
          "id": "termovalorizzatore",
          "label_it": "Termovalorizzatore",
          "filter": { "osm": { "plant:source": "waste" }, "sql": "source = 'waste'" }
        },
        {
          "id": "batterie",
          "label_it": "Batterie",
          "filter": { "osm": { "plant:source": "battery" }, "sql": "source = 'battery'" }
        },
        {
          "id": "other_unknown",
          "label_it": "Other/Unknown",
          "filter": {
            "sql": "source IS NULL OR source = '' OR source NOT IN ('coal','geothermal','hydro','nuclear','oil','gas','diesel','solar','wind','biomass','waste','battery')"
          }
        }
      ]
    },
    {
      "id": "generatori",
      "label_it": "Generatori",
      "label_en": "Power Generators",
      "layer_oim": "Power",
      "geometrie": ["Point", "Polygon"],
      "imposm_tables": ["power_generator"],
      "osm_base": { "power": ["generator"], "also": ["construction:power"] },
      "voci": [
        {
          "id": "turbina_eolica",
          "label_it": "Turbina eolica",
          "filter": {
            "osm": { "generator:source": "wind" },
            "sql": "source = 'wind'"
          }
        },
        {
          "id": "pannello_solare",
          "label_it": "Pannello solare",
          "filter": {
            "osm": { "generator:source": "solar" },
            "sql": "source = 'solar' AND GeometryType(geometry) IN ('POLYGON','MULTIPOLYGON')",
            "note": "Area/poligono (pannello)"
          }
        },
        {
          "id": "pannello_solare_nodo",
          "label_it": "Pannello solare (nodo)",
          "filter": {
            "osm": { "generator:source": "solar" },
            "sql": "source = 'solar' AND GeometryType(geometry) IN ('POINT','MULTIPOINT')",
            "note": "Nodo/punto"
          }
        },
        {
          "id": "generatore_altro",
          "label_it": "Generatore (altro)",
          "filter": {
            "sql": "COALESCE(source,'') NOT IN ('wind','solar')"
          }
        }
      ]
    },
    {
      "id": "supporti_linee",
      "label_it": "Supporti per linee elettriche",
      "label_en": "Power Line Supports",
      "layer_oim": "Power",
      "geometrie": ["Point", "LineString"],
      "imposm_tables": ["power_tower"],
      "osm_base": { "power": ["tower", "pole", "portal"] },
      "voci": [
        {
          "id": "torre_traliccio",
          "label_it": "Torre/traliccio",
          "filter": {
            "osm": { "power": ["tower", "portal"] },
            "sql": "type IN ('tower','portal') AND COALESCE(transition,false) IS NOT TRUE"
          }
        },
        {
          "id": "traliccio_transizione",
          "label_it": "Traliccio di transizione",
          "filter": {
            "osm": { "power": "tower", "location:transition": "yes" },
            "sql": "type IN ('tower','portal') AND transition IS TRUE"
          }
        },
        {
          "id": "palo_elettrico",
          "label_it": "Palo elettrico",
          "filter": {
            "osm": { "power": "pole" },
            "sql": "type = 'pole' AND COALESCE(transition,false) IS NOT TRUE"
          }
        },
        {
          "id": "palo_transizione",
          "label_it": "Palo di transizione",
          "filter": {
            "osm": { "power": "pole", "location:transition": "yes" },
            "sql": "type = 'pole' AND transition IS TRUE"
          }
        }
      ]
    },
    {
      "id": "apparecchiature_manovra",
      "label_it": "Apparecchiature di manovra",
      "label_en": "Switchgear",
      "layer_oim": "Power",
      "geometrie": ["Point", "Polygon"],
      "imposm_tables": ["power_switchgear", "power_substation"],
      "osm_base": {
        "power": ["switch", "transformer", "compensator", "converter", "insulator", "terminal"]
      },
      "voci": [
        {
          "id": "trasformatore",
          "label_it": "Trasformatore",
          "filter": {
            "osm": { "power": "transformer" },
            "sql": "type = 'transformer' AND COALESCE(transformer_type,'') NOT IN ('current','potential') AND NOT (voltage_tertiary IS NOT NULL OR windings::int = 3)"
          }
        },
        {
          "id": "trasformatore_3",
          "label_it": "Trasformatore a 3 avvolgimenti",
          "filter": {
            "osm": { "power": "transformer", "windings": "3" },
            "sql": "type = 'transformer' AND (voltage_tertiary IS NOT NULL OR windings::int = 3)"
          }
        },
        {
          "id": "current_transformer",
          "label_it": "Current transformer",
          "filter": {
            "osm": { "power": "transformer", "transformer": "current" },
            "sql": "type = 'transformer' AND transformer_type = 'current'"
          }
        },
        {
          "id": "potential_transformer",
          "label_it": "Potential transformer",
          "filter": {
            "osm": { "power": "transformer", "transformer": "potential" },
            "sql": "type = 'transformer' AND transformer_type = 'potential'"
          }
        },
        {
          "id": "sezionatore",
          "label_it": "Sezionatore",
          "filter": {
            "osm": { "power": "switch", "switch": "disconnector" },
            "sql": "type = 'switch' AND switch = 'disconnector'"
          }
        },
        {
          "id": "interruttore",
          "label_it": "Interruttore",
          "filter": {
            "osm": { "power": "switch", "switch": "circuit_breaker" },
            "sql": "type = 'switch' AND switch = 'circuit_breaker'"
          }
        },
        {
          "id": "organo_manovra_generico",
          "label_it": "Organo di manovra (generico)",
          "filter": {
            "osm": { "power": "switch" },
            "sql": "type = 'switch' AND COALESCE(switch,'') NOT IN ('disconnector','circuit_breaker')"
          }
        },
        {
          "id": "reattanza_serie",
          "label_it": "Reattanza serie",
          "filter": {
            "osm": { "power": "compensator", "compensator": "series_reactor" },
            "sql": "type = 'series_reactor' OR compensator = 'series_reactor'"
          }
        },
        {
          "id": "reattanza_shunt",
